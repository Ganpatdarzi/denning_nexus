# API base URL for split deployment (e.g. https://your-api.onrender.com)
# Leave empty for local development where Vite proxy forwards /api to the backend.
# When unset, production builds served from a *.vercel.app host fall back to
# https://denning-nexus.onrender.com (see client/src/lib/api.js).
VITE_API_URL=
