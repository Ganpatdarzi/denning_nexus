# Copy to server/.env and adjust. Never commit the real .env file.
PORT=4000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
JWT_TTL=7d
CLIENT_ORIGIN=http://localhost:5173
# DATA_FILE=./data/db.json

# Gemini is optional. Without a key, assignment audits use a local rubric and
# teacher document checks fall back to AI_NEEDS_REVIEW (never an auto-deny).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=90000

# Uploads
MAX_UPLOAD_MB=10
# UPLOAD_DIR=./data/uploads

# Application data: json | supabase
# Supabase uses the REST API with the service role key, so no database
# password or connection string is needed. Run server/db/supabase.sql once
# in the Supabase SQL Editor before switching this on.
DB_DRIVER=json
SUPABASE_STATE_TABLE=app_state

# Storage: local | supabase
# Use Supabase in production so files survive redeploys and multiple instances.
STORAGE_DRIVER=local
SUPABASE_URL=
# Server only. Never expose this key in Vite/client code.
SUPABASE_SERVICE_ROLE_KEY=
# Kept for older assignment uploads; new code uses the two named buckets below.
SUPABASE_BUCKET=denning-submissions
SUPABASE_BUCKET_ASSIGNMENTS=assignments
SUPABASE_BUCKET_TEACHER_DOCS=teacher-verifications
